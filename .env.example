# Local database (docker compose sets its own DATABASE_URL for the backend container).
DATABASE_URL=postgresql+psycopg://rodowod:rodowod@localhost:5432/rodowod

# Azure Database for PostgreSQL Flexible Server: when DB_HOST is set, these
# parameters are used instead of DATABASE_URL. See docs/backend-notes.md, section 14.
DB_HOST=
DB_PORT=5432
DB_NAME=rodowod
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DB_SSLROOTCERT=

MEDIA_DIR=./media
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LLM_API_KEY=
LLM_BASE_URL=https://kripery-project.openai.azure.com/openai/v1
LLM_MODEL=gpt-4o-mini
LOSS_MATCH_THRESHOLD=0.95
DUPLICATE_MATCH_THRESHOLD=0.92

# true: on startup fill an empty database (lost dataset + demo seed). Meant for App Service, see docs/DEPLOY.md.
AUTO_SEED=
